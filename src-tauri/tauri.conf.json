{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Claude Code Manager",
  "version": "0.1.1",
  "identifier": "io.github.pedro-b-siqueira.claude-code-manager",
  "build": {
    "beforeDevCommand": "npm run web:dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run web:build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Claude Code Manager",
        "width": 1320,
        "height": 840,
        "minWidth": 720,
        "minHeight": 520,
        "backgroundColor": "#121211",
        "incognito": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob:; font-src 'self' data:; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "DeveloperTool",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns"
    ]
  }
}
